<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <AssemblyName>Flasher.Core.Test</AssemblyName>
        <RootNamespace>Flasher.Core.Test</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Flasher.Core\Flasher.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
