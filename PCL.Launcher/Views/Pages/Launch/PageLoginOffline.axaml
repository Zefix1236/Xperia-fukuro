<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:PCL.UI.Controls"
             xmlns:launch="using:PCL.Views.Pages.Launch"
             xmlns:loc="using:PCL.Core.UI"
             mc:Ignorable="d"
             x:Class="PCL.Views.Pages.Launch.PageLoginOffline"
             d:DesignWidth="297.6">
    <!-- FORK: 按原版 PageLoginLegacy 布局重写 -->
    <!-- 布局对齐原版 PCL 的 PageLoginLegacy：提示 → 皮肤 → 可编辑用户名 -->
    <StackPanel Margin="0,0,0,5">
        <ui:MyHint x:Name="HintChinese"
                   Margin="0,0,0,15"
                   Theme="Red"
                   IsVisible="False"
                   Text="{loc:Loc Launch.Account.Offline.NameHint}" />
        <launch:MySkin x:Name="Skin"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"
                       HasCape="False" />
        <ui:MyComboBox x:Name="ComboName"
                       Height="28"
                       IsEditable="True"
                       HintText="{loc:Loc Launch.Account.Offline.NameFieldHint}" />
    </StackPanel>
</UserControl>
